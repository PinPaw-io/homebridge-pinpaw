{
  "name": "homebridge-pinpaw",
  "displayName": "PinPaw Pet Tracker",
  "version": "0.1.0",
  "description": "Homebridge plugin for the PinPaw GPS pet tracker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinPaw-io/homebridge-pinpaw.git"
  },
  "bugs": {
    "url": "https://github.com/PinPaw-io/homebridge-pinpaw/issues"
  },
  "homepage": "https://github.com/PinPaw-io/homebridge-pinpaw#readme",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.10.0 || ^22.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "pinpaw",
    "gps",
    "pet-tracker"
  ],
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src test --max-warnings 0",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm run test && npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.13.0",
    "homebridge": "^1.8.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
